{
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/macos/Sources"
  ],
  "C_Cpp.files.exclude": {
    "**/.artifacts/**": true,
    "**/.build/**": true,
    "**/DerivedData/**": true
  },
  "files.exclude": {
    "**/.artifacts": false,
    "**/.build": true,
    "**/DerivedData": true
  },
  "files.watcherExclude": {
    "**/.artifacts/**": true,
    "**/.build/**": true,
    "**/DerivedData/**": true
  },
  "search.exclude": {
    "**/.artifacts/**": true,
    "**/.build/**": true,
    "**/DerivedData/**": true
  },
  "search.followSymlinks": false
}
